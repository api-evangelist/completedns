                      "path": [
                        "dns-history",
                        ":domain"
                      ],
                      "query": [
                        {
                          "description": "(Required) API key issued in the CompleteDNS account API section.",
                          "key": "key",
                          "value": "<API Key>"
                        }
                      ],
                      "variable": [
                        {
                          "key": "domain"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
