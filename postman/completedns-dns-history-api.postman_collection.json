                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"domain\": \"<string>\",\n  \"drops\": \"<integer>\",\n  \"changes\": \"<integer>\",\n  \"years\": \"<number>\",\n  \"was_parked\": \"<boolean>\",\n  \"events\": [\n    {\n      \"date\": \"<string>\",\n      \"type\": \"start_tracking\",\n      \"nameservers\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"changes\": [\n        {\n          \"action\": \"added\",\n          \"nameserver\": \"<string>\"\n        },\n        {\n          \"action\": \"removed\",\n          \"nameserver\": \"<string>\"\n        }\n      ]\n    },\n    {\n      \"date\": \"<string>\",\n      \"type\": \"start_tracking\",\n      \"nameservers\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"changes\": [\n        {\n          \"action\": \"added\",\n          \"nameserver\": \"<string>\"\n        },\n        {\n          \"action\": \"added\",\n          \"nameserver\": \"<string>\"\n        }\n      ]\n    }\n  ]\n}",
