{
  "info": {
    "_postman_id": "7e02605b-ec47-4d9c-b31b-fe9b8ce0d29b",
    "name": "CompleteDNS API v1 DNS History API",
    "description": "The CompleteDNS API v1 returns the historical nameserver record for a domain (legacy version). The service tracks nameserver changes and domain drops and returns chronologically ordered events for a queried domain. Authentication is via an API key passed as a query string parameter. CompleteDNS recommends using the v2 API for new integrations.\n\nContact Support:\n Name: CompleteDNS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:25:12.000Z",
    "updatedAt": "2026-07-28T01:25:12.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-7e02605b-ec47-4d9c-b31b-fe9b8ce0d29b"
  },
  "item": [
    {
      "name": "dns-history",
      "item": [
        {
          "name": "{domain}",
          "item": [
            {
              "name": "Get DNS history for a domain",
              "id": "40722193-876b-4623-b278-8906fb7f7331",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/dns-history/:domain?key=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "dns-history",
                    ":domain"
                  ],
                  "query": [
                    {
                      "description": "(Required) API key issued in the CompleteDNS account API section.",
                      "key": "key",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "f579e32d-40c1-4d9c-80dd-5af58853f405",
                      "key": "domain",
                      "value": "<string>",
                      "description": "(Required) The fully qualified domain to look up."
                    }
                  ]
                },
                "description": "Returns the full history of nameserver changes and drop events for the requested domain, including the count of changes, count of drops, years tracked, and a chronologically ordered list of events."
              },
              "response": [
                {
                  "id": "8e69c3f8-5f33-4c74-8a07-356625d20c92",
                  "name": "DNS history record for the domain.",
