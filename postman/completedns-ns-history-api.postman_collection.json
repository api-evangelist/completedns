{
  "info": {
    "_postman_id": "820ebadc-b63e-4bb1-9dc9-7626f777463b",
    "name": "CompleteDNS API v1 DNS History NS History API",
    "description": "The CompleteDNS API v1 returns the historical nameserver record for a domain (legacy version). The service tracks nameserver changes and domain drops and returns chronologically ordered events for a queried domain. Authentication is via an API key passed as a query string parameter. CompleteDNS recommends using the v2 API for new integrations.\n\nContact Support:\n Name: CompleteDNS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:25:13.000Z",
    "updatedAt": "2026-07-28T01:25:13.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-820ebadc-b63e-4bb1-9dc9-7626f777463b"
  },
  "item": [
    {
      "name": "ns-history",
      "item": [
        {
          "name": "{domain}",
          "item": [
            {
              "name": "Get nameserver history for a domain",
              "id": "e9706186-6f63-41db-8816-3393c8f48847",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/ns-history/:domain?key=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "ns-history",
                    ":domain"
                  ],
                  "query": [
                    {
                      "description": "(Required) API key issued in the CompleteDNS account API section.",
                      "key": "key",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "626a3f6d-1572-4670-bfd9-24cd2a771703",
                      "key": "domain",
                      "value": "<string>",
                      "description": "(Required) The fully qualified domain to look up."
                    }
                  ]
                },
                "description": "Returns the full history of nameserver changes and drop events for the requested domain. Response includes drop count, change count, years tracked, TLD support flag, and a chronologically ordered list of events."
              },
